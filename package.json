{
  "name": "frameforge",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "description": "Local, reversible Windows gaming configuration utility",
  "author": "PREETHAM1590",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "npm run windows:ensure && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "windows:build": "dotnet build windows/Frameforge.Windows/Frameforge.Windows.csproj",
    "windows:test": "dotnet test windows/Frameforge.Windows.Tests/Frameforge.Windows.Tests.csproj",
    "windows:publish": "dotnet publish windows/Frameforge.Windows/Frameforge.Windows.csproj -c Release -r win-x64 --self-contained true -o windows/publish",
    "package:win": "npm run windows:publish && npm run build && electron-builder --win nsis --publish never",
    "start": "npm run windows:ensure && electron .",
    "test:e2e": "playwright test",
    "test:desktop": "npm run windows:ensure && node tools/desktop-smoke.mjs",
    "windows:ensure": "node tools/ensure-helper.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@node-steam/vdf": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^5.0.4",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "io.github.preetham1590.frameforge",
    "productName": "Frameforge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "windows/publish",
        "to": "windows"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Frameforge",
      "uninstallDisplayName": "Frameforge"
    },
    "copyright": "Copyright (c) 2026 PREETHAM1590",
    "artifactName": "Frameforge-Setup-${version}.exe",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "license": "MIT",
  "homepage": "https://github.com/PREETHAM1590/Frame-Forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PREETHAM1590/Frame-Forge.git"
  },
  "engines": {
    "node": ">=22.13"
  }
}
