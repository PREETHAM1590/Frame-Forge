<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>
  <!-- PreserveNewest can leave an older assembly with a newer timestamp in a reused publish folder.
       Always uses the SDK's size/timestamp comparison, so dependency changes actually replace it. -->
  <Target Name="PublishResolvedDependencies" BeforeTargets="_ComputeResolvedFilesToPublishTypes">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
